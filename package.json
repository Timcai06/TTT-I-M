{
  "name": "ttt-i-m-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "npm run setup --workspace @timcai/landing",
    "dev": "npm run dev --workspace @timcai/landing",
    "dev:landing": "npm run dev --workspace @timcai/landing",
    "dev:studio": "npm run dev --workspace @timcai/studio",
    "build": "npm run build --workspace @timcai/landing",
    "build:landing": "npm run build --workspace @timcai/landing",
    "build:studio": "npm run build --workspace @timcai/studio",
    "typecheck": "npm run typecheck --workspace @timcai/landing && npm run typecheck --workspace @timcai/studio",
    "typecheck:landing": "npm run typecheck --workspace @timcai/landing",
    "typecheck:studio": "npm run typecheck --workspace @timcai/studio",
    "lint": "npm run lint --workspace @timcai/landing && npm run lint --workspace @timcai/studio",
    "lint:landing": "npm run lint --workspace @timcai/landing",
    "lint:studio": "npm run lint --workspace @timcai/studio",
    "test:build": "npm run build:landing && npm run test:build --workspace @timcai/landing && node tests/build/platform-guards.mjs",
    "test:build:landing": "npm run test:build --workspace @timcai/landing",
    "test:smoke": "node tests/runtime/cross-zone-smoke.mjs",
    "test:e2e:frame": "npm run test:e2e:frame --workspace @timcai/landing"
  },
  "devDependencies": {
    "@types/three": "0.182.0",
    "three": "0.182.0"
  },
  "overrides": {
    "three": "0.182.0"
  }
}
