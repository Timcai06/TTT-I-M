{
  "name": "ttt-i-m-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24 <26",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "npm run setup --workspace @timcai/landing",
    "dev": "npm run dev --workspace @timcai/landing",
    "dev:canvas": "npm run dev:canvas --workspace @timcai/landing",
    "dev:landing": "npm run dev --workspace @timcai/landing",
    "dev:studio": "npm run dev --workspace @timcai/studio",
    "build": "npm run build --workspace @timcai/landing",
    "build:landing": "npm run build --workspace @timcai/landing",
    "build:studio": "npm run build --workspace @timcai/studio",
    "typecheck": "npm run typecheck --workspace @timcai/landing && npm run typecheck --workspace @timcai/studio",
    "typecheck:landing": "npm run typecheck --workspace @timcai/landing",
    "typecheck:studio": "npm run typecheck --workspace @timcai/studio",
    "lint": "npm run lint --workspace @timcai/landing && npm run lint --workspace @timcai/studio",
    "lint:landing": "npm run lint --workspace @timcai/landing",
    "lint:studio": "npm run lint --workspace @timcai/studio",
    "test:build": "npm run build:landing && npm run test:guards --workspace @timcai/landing && npm run test:content && node tests/build/platform-guards.mjs",
    "test:build:landing": "npm run test:build --workspace @timcai/landing",
    "test:smoke": "node tests/runtime/cross-zone-smoke.mjs",
    "test:unit": "npm run test:content && npm run test:studio && npm run test:unit --workspace @timcai/landing",
    "test:studio": "node --import ./packages/content/tests/register-ts-loader.mjs --test apps/studio/tests/*.test.ts",
    "test:e2e": "npm run test:e2e --workspace @timcai/landing",
    "test:e2e:gates": "npm run test:e2e:gates --workspace @timcai/landing",
    "test:e2e:canvas-experimental": "npm run test:e2e:canvas-experimental --workspace @timcai/landing",
    "test:e2e:frame": "npm run test:e2e:frame --workspace @timcai/landing",
    "test:content": "node --import ./packages/content/tests/register-ts-loader.mjs --test packages/content/tests/*.test.ts"
  },
  "devDependencies": {
    "@types/three": "0.182.0",
    "three": "0.185.1"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "js-yaml": "3.15.2",
    "three": "0.185.1"
  }
}
