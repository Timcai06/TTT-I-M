# Public Chrome token; leave empty for local/Preview DOM fallback.
# Existing Vercel Production token-only setup uses the index.html canonical www origin.
HTML_IN_CANVAS_ORIGIN_TRIAL_TOKEN=
# Optional target override; leave unset unless intentionally targeting another origin.
# HTML_IN_CANVAS_ORIGIN_TRIAL_ORIGIN=https://www.crt-dsg.com
# VERCEL_ENV / VERCEL_URL are supplied by Vercel, not Vite mode=production.
# A non-target Preview skips inherited production tokens and retains DOM fallback.
# Payload checks do not verify signatures or registration Valid Until.
