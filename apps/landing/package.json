{
  "name": "@timcai/landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-assets.mjs",
    "predev": "node scripts/setup-assets.mjs",
    "predev:canvas": "node scripts/setup-assets.mjs",
    "prebuild": "node scripts/setup-assets.mjs",
    "dev": "vite --port 5173 --strictPort",
    "dev:canvas": "node scripts/dev-canvas.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --pretty false",
    "lint": "eslint .",
    "test:build": "npm run build && npm run test:guards",
    "test:guards": "npm run test:build:chunks && npm run test:build:architecture && npm run test:build:frame && npm run test:build:loader && npm run test:build:content && npm run test:build:bytes && npm run test:build:effects",
    "test:build:bytes": "node tests/build/deferred-image-budget-guards.mjs",
    "test:build:architecture": "node tests/build/chapter-state-guards.mjs",
    "test:build:chunks": "node tests/build/chunk-guards.mjs",
    "test:build:frame": "node tests/build/frame-architecture-guards.mjs",
    "test:build:loader": "node tests/build/loader-preload-guards.mjs",
    "test:build:content": "node tests/build/content-layer-guards.mjs",
    "test:build:effects": "node tests/build/experience-effects-guards.mjs",
    "test:unit": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:gates": "playwright test --project=chromium-desktop tests/e2e/degradation.spec.ts tests/e2e/chrome-ui.spec.ts tests/e2e/hero-pretext.spec.ts tests/e2e/effects-context.spec.ts tests/e2e/accessibility.spec.ts tests/e2e/canvas-ui-effects.spec.ts",
    "test:e2e:canvas-experimental": "HTML_CANVAS_EXPERIMENTAL=1 playwright test --project=chromium-desktop tests/e2e/canvas-ui-experimental.spec.ts",
    "test:e2e:frame": "playwright test tests/e2e/frame.spec.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@chenglou/pretext": "^0.0.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@fontsource/playfair-display": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "@number-flow/react": "^0.6.2",
    "@react-three/fiber": "^9.6.1",
    "@timcai/content": "0.0.0",
    "@timcai/tokens": "0.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "mathjs": "^15.2.0",
    "photoswipe": "^5.4.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.2.2",
    "vite-plugin-glsl": "^1.6.0",
    "vite-plugin-image-optimizer": "^2.0.3"
  }
}
