{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:landing",
  "outputDirectory": "apps/landing/dist",
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/_next/:path*",
      "destination": "https://ttt-i-m-studio.vercel.app/_next/:path*"
    },
    {
      "source": "/__studio/build-meta.json",
      "destination": "https://ttt-i-m-studio.vercel.app/api/build-meta"
    },
    {
      "source": "/blog",
      "destination": "https://ttt-i-m-studio.vercel.app/blog"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://ttt-i-m-studio.vercel.app/blog/:path*"
    },
    {
      "source": "/work",
      "destination": "https://ttt-i-m-studio.vercel.app/work"
    },
    {
      "source": "/work/:path*",
      "destination": "https://ttt-i-m-studio.vercel.app/work/:path*"
    },
    {
      "source": "/graph",
      "destination": "https://ttt-i-m-studio.vercel.app/graph"
    },
    {
      "source": "/graph/:path*",
      "destination": "https://ttt-i-m-studio.vercel.app/graph/:path*"
    },
    {
      "source": "/dashboard",
      "destination": "https://ttt-i-m-studio.vercel.app/dashboard"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://ttt-i-m-studio.vercel.app/dashboard/:path*"
    },
    {
      "source": "/rss.xml",
      "destination": "https://ttt-i-m-studio.vercel.app/rss.xml"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://ttt-i-m-studio.vercel.app/sitemap.xml"
    }
  ],
  "headers": [
    {
      "source": "/build-meta.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*).woff2",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(frame|life|projects|portrait|noise)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=31536000"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; script-src 'self' 'sha256-+3Vw4kd8fR9/9ApEdkSB+XW9kPn3SzFHdnvj5Ozzay8=' 'sha256-XJ8PhdG2uXxycBVP0kMC0AFCnbqO0u9g3CuQR0ilu+U=' 'sha256-dUQWf519IUQZM7lIeI5+ApscASKWx4hnhCfL89ZtgAY=' 'sha256-d37lbyHzOMxOF8c/qTsZ/ndGH6F0QEpZN3wkt6fvJow=' https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://vitals.vercel-insights.com https://va.vercel-scripts.com; worker-src 'self' blob:; frame-src 'self' data: blob:; frame-ancestors 'self'"
        }
      ]
    }
  ]
}
